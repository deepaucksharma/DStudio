// ============================================================================
// REAL-TIME DRIVER MATCHING ALGORITHM
// ============================================================================

CREATE QUERY find_optimal_driver(STRING rider_id, FLOAT pickup_lat, FLOAT pickup_lng, STRING vehicle_type_requested) 
FOR GRAPH OlaRideGraph {
    
    // Performance optimization variables
    TYPEDEF TUPLE<STRING driver_id, FLOAT score, FLOAT distance, INT eta, STRING driver_name, FLOAT rating> DriverMatch;
    HeapAccum<DriverMatch>(15, score DESC) @@top_drivers;
    
    // Get rider preferences
    start_rider = {Rider.*} WHERE Rider.rider_id == rider_id;
    
    // Find available drivers within 5km radius
    available_drivers = SELECT d 
                       FROM Driver:d
                       WHERE d.is_available == true 
                         AND d.is_online == true
                         AND d.duty_status == "ONLINE"
                         AND d.vehicle_type == vehicle_type_requested
                         AND d.last_location_update > datetime_sub(now(), INTERVAL 10 MINUTE)
                         AND calculate_distance(pickup_lat, pickup_lng, d.current_lat, d.current_lng) <= 5.0;
    
    // Multi-factor scoring algorithm
    matched_drivers = SELECT d
                     FROM available_drivers:d
                     ACCUM 
                         // Distance and ETA calculation
                         FLOAT distance = calculate_distance(pickup_lat, pickup_lng, d.current_lat, d.current_lng),
                         INT base_eta = CASE 
                                         WHEN distance <= 0.5 THEN 2
                                         WHEN distance <= 1.0 THEN 4
                                         WHEN distance <= 2.0 THEN 8
                                         WHEN distance <= 3.0 THEN 12
                                         ELSE 18
                                       END,
                         
                         // Traffic adjustment for Mumbai conditions
                         FLOAT traffic_multiplier = get_traffic_multiplier(d.current_area),
                         INT traffic_adjusted_eta = base_eta * traffic_multiplier,
                         
                         // Scoring factors (Mumbai optimized)
                         FLOAT distance_score = (5.0 - distance) * 15,  // Closer is better
                         FLOAT rating_score = d.rating * 25,            // Higher rating preferred
                         FLOAT acceptance_score = d.acceptance_rate * 20, // Reliable drivers
                         FLOAT completion_score = d.completion_rate * 15, // Consistent performers
                         
                         // Mumbai-specific factors
                         FLOAT local_knowledge_score = CASE 
                                                        WHEN d.knows_shortcuts == true THEN 10
                                                        ELSE 0
                                                      END,
                         
                         FLOAT area_familiarity_score = CASE 
                                                         WHEN get_area_name(pickup_lat, pickup_lng) IN d.preferred_areas THEN 15
                                                         ELSE 0
                                                       END,
                         
                         FLOAT experience_score = MIN(d.mumbai_experience_years, 10),
                         
                         // Availability and workload factors
                         FLOAT workload_score = CASE 
                                                 WHEN d.hours_worked_today < 6 THEN 10
                                                 WHEN d.hours_worked_today < 10 THEN 5
                                                 ELSE 0
                                               END,
                         
                         // Language compatibility (Mumbai multilingual)
                         FLOAT language_score = CASE 
                                                 WHEN "Hindi" IN d.local_language_support THEN 5
                                                 ELSE 0
                                               END,
                         
                         // Rush hour and monsoon adjustments
                         FLOAT peak_hour_bonus = CASE 
                                                  WHEN is_peak_hour() AND d.rating > 4.5 THEN 8
                                                  ELSE 0
                                                END,
                         
                         FLOAT monsoon_bonus = CASE 
                                                WHEN is_monsoon_season() AND d.completion_rate > 0.95 THEN 12
                                                ELSE 0
                                              END,
                         
                         // Calculate total score
                         FLOAT total_score = distance_score + rating_score + acceptance_score + completion_score + 
                                           local_knowledge_score + area_familiarity_score + experience_score + 
                                           workload_score + language_score + peak_hour_bonus + monsoon_bonus,
                         
                         @@top_drivers += DriverMatch(d.driver_id, total_score, distance, traffic_adjusted_eta, d.name, d.rating);
    
    PRINT @@top_drivers;
}

// ============================================================================
// BATCH RIDE ASSIGNMENT ALGORITHM
// ============================================================================

CREATE QUERY batch_ride_assignment() FOR GRAPH OlaRideGraph {
    
    // Statistics tracking
    INT @@total_requests = 0;
    INT @@successful_assignments = 0;
    INT @@failed_assignments = 0;
    
    // Get all pending ride requests (last 2 minutes)
    pending_requests = SELECT r FROM RideRequest:r 
                      WHERE r.status == "SEARCHING" 
                        AND r.request_time > datetime_sub(now(), INTERVAL 2 MINUTE);
    
    // Process each request with priority
    prioritized_requests = SELECT r FROM pending_requests:r
                          ACCUM 
                              // Calculate priority score based on wait time and rider profile
                              FLOAT wait_time_minutes = datetime_diff(now(), r.request_time) / 60.0,
                              FLOAT priority_score = wait_time_minutes * 10,  // Base priority from wait time
                              
                              // Rider premium status bonus
                              @@total_requests += 1
                          ORDER BY priority_score DESC;
    
    // Assign drivers to high-priority requests first
    FOREACH request IN prioritized_requests DO
        // Get rider details
        request_rider = SELECT rider FROM RideRequest:req -(REQUESTS_RIDE)- Rider:rider 
                       WHERE req.request_id == request.request_id;
        
        // Find optimal driver using our matching algorithm
        optimal_driver_result = find_optimal_driver(
            request_rider.rider_id, 
            request.pickup_lat, 
            request.pickup_lng,
            request.vehicle_type_requested
        );
        
        // Check if we found available drivers
        IF optimal_driver_result.size() > 0 THEN
            best_driver = optimal_driver_result[0];
            
            // Create assignment relationship
            INSERT INTO ASSIGNED_TO VALUES(
                best_driver.driver_id, 
                request.request_id,
                now(),
                best_driver.eta,
                calculate_acceptance_probability(best_driver.score),
                best_driver.distance
            );
            
            // Update request status
            UPDATE RideRequest SET status = "ASSIGNED", assignment_time = now() 
            WHERE request_id == request.request_id;
            
            // Update driver availability
            UPDATE Driver SET is_available = false, duty_status = "ASSIGNED"
            WHERE driver_id == best_driver.driver_id;
            
            // Send push notification to driver (simulate)
            send_driver_notification(best_driver.driver_id, request.request_id);
            
            @@successful_assignments += 1;
            
        ELSE
            // No drivers available
            @@failed_assignments += 1;
            
            // Check if we should increase surge pricing
            IF should_increase_surge_pricing(request.pickup_area) THEN
                increase_area_surge_multiplier(request.pickup_area);
            END;
        END;
    END;
    
    // Return assignment statistics
    PRINT @@total_requests as total_requests;
    PRINT @@successful_assignments as successful_assignments;
    PRINT @@failed_assignments as failed_assignments;
    PRINT (@@successful_assignments * 100.0 / @@total_requests) as success_rate;
}

// ============================================================================
// ROUTE OPTIMIZATION FOR MULTI-STOP TRIPS
// ============================================================================

CREATE QUERY optimize_multi_stop_route(STRING driver_id, SET<STRING> pickup_locations) 
FOR GRAPH OlaRideGraph {
    
    TYPEDEF TUPLE<STRING location_id, FLOAT lat, FLOAT lng, INT sequence> RoutePoint;
    ListAccum<RoutePoint> @@optimal_route;
    
    // Get driver's current location
    driver_location = SELECT d FROM Driver:d WHERE d.driver_id == driver_id;
    
    // Get all pickup locations with coordinates
    pickup_points = SELECT l FROM Location:l WHERE l.location_id IN pickup_locations;
    
    // Implement nearest neighbor TSP approximation for Mumbai traffic
    STRING current_location = driver_id;
    SET<STRING> unvisited = pickup_locations;
    INT sequence_number = 1;
    
    // Add driver's current position as starting point
    @@optimal_route += RoutePoint(driver_id, driver_location.current_lat, driver_location.current_lng, 0);
    
    // Greedy nearest neighbor with Mumbai traffic considerations
    WHILE unvisited.size() > 0 DO
        FLOAT min_travel_time = 999999;
        STRING next_location = "";
        
        // Find nearest unvisited location considering traffic
        FOREACH loc IN unvisited DO
            FLOAT travel_time = calculate_mumbai_travel_time(current_location, loc);
            
            IF travel_time < min_travel_time THEN
                min_travel_time = travel_time;
                next_location = loc;
            END;
        END;
        
        // Add to route
        next_point = SELECT l FROM Location:l WHERE l.location_id == next_location;
        @@optimal_route += RoutePoint(next_location, next_point.lat, next_point.lng, sequence_number);
        
        // Update for next iteration
        current_location = next_location;
        unvisited = unvisited MINUS (next_location);
        sequence_number = sequence_number + 1;
    END;
    
    PRINT @@optimal_route;
}

// ============================================================================
// PERFORMANCE ANALYTICS AND INSIGHTS
// ============================================================================

CREATE QUERY driver_performance_analytics(STRING time_period) FOR GRAPH OlaRideGraph {
    
    DATETIME start_time = CASE time_period
                           WHEN "today" THEN datetime_sub(now(), INTERVAL 1 DAY)
                           WHEN "week" THEN datetime_sub(now(), INTERVAL 7 DAY)
                           WHEN "month" THEN datetime_sub(now(), INTERVAL 30 DAY)
                           ELSE datetime_sub(now(), INTERVAL 1 DAY)
                         END;
    
    // Analyze driver performance metrics
    driver_stats = SELECT d.driver_id,
                          d.name,
                          d.vehicle_type,
                          d.current_area,
                          d.rating,
                          count(t.trip_id) as trips_completed,
                          sum(t.driver_earnings) as total_earnings,
                          avg(t.rider_rating) as avg_rider_rating,
                          avg(t.actual_duration) as avg_trip_duration,
                          avg(t.route_efficiency_score) as avg_efficiency
                   FROM Driver:d -(COMPLETED_TRIP)- Rider:r, 
                        Trip:t
                   WHERE t.start_time >= start_time
                     AND t.driver_id == d.driver_id
                   GROUP BY d.driver_id;
    
    // Top performers identification
    top_performers = SELECT d.driver_id,
                           d.name,
                           d.total_earnings,
                           d.avg_rider_rating,
                           d.trips_completed,
                           (d.total_earnings / d.trips_completed) as earnings_per_trip,
                           CASE 
                             WHEN d.avg_rider_rating >= 4.7 AND d.trips_completed >= 50 THEN "Star Driver"
                             WHEN d.avg_rider_rating >= 4.5 AND d.trips_completed >= 30 THEN "Good Driver"
                             WHEN d.avg_rider_rating >= 4.0 AND d.trips_completed >= 20 THEN "Average Driver"
                             ELSE "Needs Improvement"
                           END as performance_category
                    FROM driver_stats:d
                    ORDER BY d.total_earnings DESC, d.avg_rider_rating DESC;
    
    PRINT top_performers;
}

// ============================================================================
// SURGE PRICING ALGORITHM
// ============================================================================

CREATE QUERY calculate_dynamic_pricing() FOR GRAPH OlaRideGraph {
    
    // Analyze demand vs supply by area
    area_metrics = SELECT l.area_name,
                          l.zone,
                          count(pending_requests.request_id) as pending_demand,
                          count(available_drivers.driver_id) as available_supply,
                          avg(l.current_traffic_density) as traffic_level
                   FROM Location:l,
                        RideRequest:pending_requests,
                        Driver:available_drivers
                   WHERE pending_requests.pickup_area == l.area_name
                     AND pending_requests.status == "SEARCHING"
                     AND available_drivers.current_area == l.area_name
                     AND available_drivers.is_available == true
                   GROUP BY l.area_name;
    
    // Calculate surge multiplier
    surge_recommendations = SELECT a.area_name,
                                  a.pending_demand,
                                  a.available_supply,
                                  a.traffic_level,
                                  CASE 
                                    WHEN a.available_supply == 0 THEN 3.0
                                    ELSE MAX(1.0, MIN(3.0, a.pending_demand * 1.0 / a.available_supply))
                                  END as recommended_surge_multiplier,
                                  CASE 
                                    WHEN a.traffic_level > 0.8 THEN "High Traffic Surge"
                                    WHEN a.pending_demand > a.available_supply * 2 THEN "High Demand Surge"
                                    ELSE "Normal Pricing"
                                  END as surge_reason
                           FROM area_metrics:a
                           WHERE a.pending_demand > 0;
    
    PRINT surge_recommendations;
}

