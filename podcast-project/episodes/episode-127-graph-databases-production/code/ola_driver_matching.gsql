/*
 * Ola Driver-Rider Matching System - TigerGraph GSQL Implementation
 * =================================================================
 * 
 * यह system Ola के real-time driver-rider matching को handle करता है।
 * Mumbai traffic और demand patterns को consider करते हुए optimal matching।
 * 
 * Features:
 * - Real-time driver availability tracking
 * - Multi-factor matching algorithm
 * - Traffic-aware ETA calculations
 * - Dynamic pricing support
 * - Route optimization
 * 
 * Scale: 1M drivers, 150M riders, 1M rides per day
 * Response time: <200ms for matching
 * 
 * Author: Ola Mumbai Engineering Team
 */

// ============================================================================
// GRAPH SCHEMA DEFINITION
// ============================================================================

USE GRAPH OlaRideGraph

// Create vertex types for Ola ecosystem
CREATE VERTEX Driver (
    PRIMARY_ID driver_id STRING,
    name STRING,
    phone STRING,
    email STRING,
    license_number STRING,
    vehicle_type STRING,  // "Micro", "Mini", "Prime", "Auto"
    vehicle_number STRING,
    rating FLOAT,
    trips_completed INT,
    total_earnings FLOAT,
    
    // Real-time location data
    current_lat FLOAT,
    current_lng FLOAT,
    current_area STRING,
    last_location_update DATETIME,
    
    // Availability status
    is_available BOOL,
    is_online BOOL,
    duty_status STRING,  // "ONLINE", "OFFLINE", "ON_TRIP", "BREAK"
    
    // Performance metrics
    acceptance_rate FLOAT,
    cancellation_rate FLOAT,
    completion_rate FLOAT,
    avg_rating FLOAT,
    
    // Working patterns
    preferred_areas SET<STRING>,
    shift_start_time TIME,
    shift_end_time TIME,
    hours_worked_today FLOAT,
    
    // Mumbai specific
    local_language_support SET<STRING>,  // ["Hindi", "Marathi", "English"]
    knows_shortcuts BOOL,
    mumbai_experience_years INT
) WITH primary_id_as_attribute="true"

CREATE VERTEX Rider (
    PRIMARY_ID rider_id STRING,
    name STRING,
    phone STRING,
    email STRING,
    age INT,
    gender STRING,
    
    // Current location for ride request
    current_lat FLOAT,
    current_lng FLOAT,
    current_area STRING,
    
    // Profile information
    rating FLOAT,
    total_rides INT,
    total_spent FLOAT,
    preferred_payment STRING,  // "Cash", "Wallet", "UPI", "Card"
    
    // Preferences
    preferred_vehicle_types SET<STRING>,
    max_wait_time INT,  // minutes
    price_sensitivity STRING,  // "Low", "Medium", "High"
    
    // Behavioral patterns
    avg_ride_distance FLOAT,
    avg_ride_cost FLOAT,
    frequent_routes SET<STRING>,
    peak_hour_usage BOOL,
    
    // Mumbai specific
    home_area STRING,
    office_area STRING,
    language_preference STRING
) WITH primary_id_as_attribute="true"

CREATE VERTEX Location (
    PRIMARY_ID location_id STRING,
    area_name STRING,
    lat FLOAT,
    lng FLOAT,
    location_type STRING,  // "Residential", "Commercial", "Transport Hub", "Entertainment"
    
    // Traffic and demand data
    current_traffic_density FLOAT,  // 0.0 to 1.0
    avg_demand_multiplier FLOAT,
    surge_pricing_active BOOL,
    surge_multiplier FLOAT,
    
    // Mumbai specific areas
    zone STRING,  // "South Mumbai", "Western Suburbs", "Central", "Eastern", "Navi Mumbai"
    is_airport BOOL,
    is_railway_station BOOL,
    is_mall BOOL,
    
    // Weather impact
    weather_condition STRING,
    rainfall_impact FLOAT
) WITH primary_id_as_attribute="true"

CREATE VERTEX RideRequest (
    PRIMARY_ID request_id STRING,
    rider_id STRING,
    
    // Pickup and drop locations
    pickup_lat FLOAT,
    pickup_lng FLOAT,
    pickup_area STRING,
    drop_lat FLOAT,
    drop_lng FLOAT,
    drop_area STRING,
    
    // Request details
    vehicle_type_requested STRING,
    passenger_count INT,
    scheduled_time DATETIME,
    special_requirements SET<STRING>,  // ["AC", "Pet Friendly", "Wheelchair Accessible"]
    
    // Pricing
    estimated_distance FLOAT,
    estimated_duration INT,  // minutes
    estimated_fare FLOAT,
    max_fare_willing FLOAT,
    
    // Status tracking
    status STRING,  // "REQUESTED", "SEARCHING", "ASSIGNED", "ACCEPTED", "STARTED", "COMPLETED", "CANCELLED"
    request_time DATETIME,
    assignment_time DATETIME,
    pickup_time DATETIME,
    drop_time DATETIME,
    
    // Mumbai rush hour considerations
    is_peak_hour BOOL,
    traffic_factor FLOAT,
    monsoon_factor FLOAT
) WITH primary_id_as_attribute="true"

CREATE VERTEX Trip (
    PRIMARY_ID trip_id STRING,
    request_id STRING,
    driver_id STRING,
    rider_id STRING,
    
    // Trip details
    start_time DATETIME,
    end_time DATETIME,
    actual_distance FLOAT,
    actual_duration INT,
    
    // Route information
    route_taken STRING,  // Encoded polyline
    traffic_conditions SET<STRING>,
    avg_speed FLOAT,
    
    // Financial details
    base_fare FLOAT,
    distance_fare FLOAT,
    time_fare FLOAT,
    surge_fare FLOAT,
    toll_charges FLOAT,
    total_fare FLOAT,
    commission_charged FLOAT,
    driver_earnings FLOAT,
    
    // Ratings
    rider_rating FLOAT,
    driver_rating FLOAT,
    feedback_comments STRING,
    
    // Mumbai specific
    monsoon_delay_minutes INT,
    traffic_jam_count INT,
    route_efficiency_score FLOAT
) WITH primary_id_as_attribute="true"

// ============================================================================
// EDGE DEFINITIONS - Relationships
// ============================================================================

CREATE DIRECTED EDGE NEAR_LOCATION (
    FROM Driver TO Location,
    distance_km FLOAT,
    estimated_arrival_time INT,  // minutes
    traffic_adjusted_time INT,
    last_calculated DATETIME
)

CREATE DIRECTED EDGE REQUESTS_RIDE (
    FROM Rider TO RideRequest,
    timestamp DATETIME,
    priority_score FLOAT,
    wait_time_tolerance INT
)

CREATE DIRECTED EDGE ASSIGNED_TO (
    FROM Driver TO RideRequest,
    assignment_time DATETIME,
    estimated_pickup_time INT,
    acceptance_probability FLOAT,
    distance_to_pickup FLOAT
)

CREATE DIRECTED EDGE COMPLETED_TRIP (
    FROM Driver TO Rider,
    trip_id STRING,
    trip_date DATETIME,
    route_taken STRING,
    fare_charged FLOAT,
    rating_given FLOAT,
    trip_duration INT,
    pickup_area STRING,
    drop_area STRING
)

CREATE UNDIRECTED EDGE FREQUENT_ROUTE (
    FROM Location TO Location,
    route_frequency INT,
    avg_duration INT,
    avg_distance FLOAT,
    peak_hour_multiplier FLOAT,
    traffic_pattern STRING
)

CREATE DIRECTED EDGE PREFERS_AREA (
    FROM Driver TO Location,
    preference_strength FLOAT,
    earnings_in_area FLOAT,
    trips_completed_in_area INT,
    comfort_level FLOAT
)

