CREATE FUNCTION calculate_mumbai_travel_time(STRING from_loc, STRING to_loc) RETURNS FLOAT {
    // Mumbai-specific travel time calculation considering traffic, monsoon, etc.
    FLOAT base_time = calculate_distance_between_locations(from_loc, to_loc) * 3.0;  // 3 min per km average
    FLOAT traffic_factor = get_current_traffic_factor();
