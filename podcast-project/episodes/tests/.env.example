# ==============================================
# TEST DATA CONFIGURATION
# ==============================================

# Test Users
TEST_USER_COUNT=1000
TEST_ADMIN_EMAIL=admin@test.example.com
TEST_ADMIN_PASSWORD=SecureTestPassword123

# Mock Data Settings
GENERATE_INDIAN_NAMES=true
GENERATE_INDIAN_ADDRESSES=true
GENERATE_INDIAN_PHONE_NUMBERS=true
GENERATE_MOCK_TRANSACTIONS=true

# Data Retention
TEST_DATA_RETENTION_DAYS=7
LOG_RETENTION_DAYS=30
PERFORMANCE_DATA_RETENTION_DAYS=90

# ==============================================
# CI/CD CONFIGURATION
# ==============================================

# CI Environment Detection
CI=false
GITHUB_ACTIONS=false
JENKINS=false

# Test Execution
PARALLEL_TEST_WORKERS=4
TEST_TIMEOUT_MINUTES=60
FAIL_FAST=false

# Reporting
GENERATE_HTML_REPORT=true
GENERATE_XML_REPORT=true
GENERATE_JSON_REPORT=true
UPLOAD_RESULTS_TO_S3=false

# ==============================================
# DEBUGGING AND LOGGING
# ==============================================

# Log Levels
LOG_LEVEL=INFO
TEST_LOG_LEVEL=DEBUG
SECURITY_LOG_LEVEL=WARNING

# Debug Modes
DEBUG_MODE=false
VERBOSE_LOGGING=false
TRACE_REQUESTS=false
CAPTURE_SCREENSHOTS=true

# ==============================================
# EXTERNAL INTEGRATIONS
# ==============================================

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
SLACK_CHANNEL=#testing
SLACK_USERNAME=TestBot

# GitHub Integration
GITHUB_TOKEN=
GITHUB_REPO=username/repo
GITHUB_PR_COMMENTS=true

# JIRA Integration
JIRA_URL=https://company.atlassian.net
JIRA_USERNAME=test@example.com
JIRA_API_TOKEN=api_token
JIRA_PROJECT_KEY=TEST

# ==============================================
# CUSTOM SETTINGS
# ==============================================

# Add your custom environment variables here
CUSTOM_SETTING_1=value1
CUSTOM_SETTING_2=value2

# Feature Flags
ENABLE_NEW_FEATURES=false
ENABLE_EXPERIMENTAL_TESTS=false
ENABLE_LOAD_TESTING=true
ENABLE_CHAOS_TESTING=false