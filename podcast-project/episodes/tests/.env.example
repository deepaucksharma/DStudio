# Environment Configuration Template
# पर्यावरण कॉन्फ़िगरेशन टेम्पलेट

# ==============================================
# BASIC CONFIGURATION
# ==============================================

# Test Environment
TEST_ENV=development
INDIAN_REGION=mumbai
TEST_TIMEOUT=300

# Application URLs
API_BASE_URL=https://api-staging.example.com
AUTH_SERVICE_URL=https://auth-staging.example.com
FRONTEND_URL=https://app-staging.example.com

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# Primary Database
TEST_DB_URL=postgresql://testuser:testpass@localhost:5432/testdb
TEST_DB_POOL_SIZE=20
TEST_DB_MAX_OVERFLOW=30

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# MongoDB (for document storage)
MONGO_URL=mongodb://localhost:27017/testdb
MONGO_USERNAME=testuser
MONGO_PASSWORD=testpass

# ==============================================
# SERVICE DISCOVERY
# ==============================================

# Consul
CONSUL_URL=http://localhost:8500
CONSUL_TOKEN=

# Etcd
ETCD_URL=http://localhost:2379
ETCD_USERNAME=
ETCD_PASSWORD=

# ==============================================
# MONITORING AND OBSERVABILITY
# ==============================================

# Prometheus
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_USERNAME=
PROMETHEUS_PASSWORD=

# Grafana
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=

# Jaeger (Tracing)
JAEGER_URL=http://localhost:14268
JAEGER_SERVICE_NAME=hindi-podcast-tests

# ==============================================
# LOAD TESTING CONFIGURATION
# ==============================================

# K6 Configuration
MAX_VUS=10000
DEFAULT_DURATION=300s
TARGET_TPS=5000
RAMP_UP_DURATION=30s
RAMP_DOWN_DURATION=30s

# Regional Load Testing
MUMBAI_LATENCY_MS=50
DELHI_LATENCY_MS=75
BANGALORE_LATENCY_MS=60
CHENNAI_LATENCY_MS=80
KOLKATA_LATENCY_MS=90

# Festival Traffic Multipliers
DIWALI_TRAFFIC_MULTIPLIER=15
IPL_TRAFFIC_MULTIPLIER=25
CRICKET_WORLD_CUP_MULTIPLIER=30
NEW_YEAR_MULTIPLIER=20
HOLI_TRAFFIC_MULTIPLIER=12

# ==============================================
# CHAOS ENGINEERING
# ==============================================

# Chaos Monkey Configuration
CHAOS_MONKEY_ENABLED=false
DEFAULT_FAILURE_RATE=0.1
CHAOS_DURATION=300s
RECOVERY_TIME=60s

# Network Chaos
NETWORK_PARTITION_PROBABILITY=0.05
NETWORK_DELAY_MS=1000
PACKET_LOSS_RATE=0.01

# Service Chaos
SERVICE_FAILURE_RATE=0.1
DATABASE_OVERLOAD_RATE=0.05
MEMORY_EXHAUSTION_RATE=0.02

# ==============================================
# SECURITY TESTING
# ==============================================

# OWASP ZAP
OWASP_ZAP_URL=http://localhost:8080
OWASP_ZAP_API_KEY=

# Security Scanning
SECURITY_SCAN_ENABLED=true
VULNERABILITY_SCAN_ENABLED=true
PENETRATION_TEST_ENABLED=false

# Indian Compliance
PDP_BILL_COMPLIANCE_CHECK=true
RBI_GUIDELINES_CHECK=true
DATA_LOCALIZATION_CHECK=true

# ==============================================
# PAYMENT GATEWAY TESTING
