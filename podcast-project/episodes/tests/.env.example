API_RESPONSE_TIME_P99_MS=200
API_THROUGHPUT_RPS=1000

# Database Performance
DB_QUERY_TIME_P95_MS=50
DB_CONNECTION_POOL_SIZE=20
DB_SLOW_QUERY_THRESHOLD_MS=100

# UPI Transaction Performance
